# A model served through a LiteLLM proxy. Copy to litellm.env and fill in.
ANTHROPIC_BASE_URL=https://litellm.example.org
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME
# The model name as LiteLLM exposes it; forwarded to `claude --model`, overriding
# the `model` in .claude/settings.json.
AVOCADO_MODEL=claude-sonnet-4-5
# Keep the container from calling Anthropic for anything but model requests.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

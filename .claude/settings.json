{
    "model": "claude-opus-4-8",
    "env": {
        "API_TIMEOUT_MS": "1200000",
        "BASH_DEFAULT_TIMEOUT_MS": "600000",
        "CLAUDE_CODE_EFFORT_LEVEL": "max"
    },
    "permissions": {
        "allow": [
            "Bash(avocado-*)"
        ],
        "deny": [
            "Bash(*eval*)",
            "Read(*eval*)",
            "Read(**/*mutation_compile_failures.log)"
        ]
    }
}

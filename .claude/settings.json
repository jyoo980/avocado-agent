{
    "model": "claude-opus-4-8",
    "env": {
        "API_TIMEOUT_MS": "1200000",
        "BASH_DEFAULT_TIMEOUT_MS": "600000",
        "CLAUDE_CODE_EFFORT_LEVEL": "high"
    },
    "permissions": {
        "allow": [
            "Bash(avocado-*)"
        ],
        "deny": [
            "Bash(*git*)",
            "Bash(*.git*)",
            "Read(*.git*)",
            "Bash(*eval*)",
            "Bash(*run_cbmc*)",
            "Bash(*tools/run_cbmc.py*)",
            "Read(*tools/run_cbmc.py*)",
            "Bash(*get_topological_ordering_of_functions*)",
            "Bash(*tools/get_topological_ordering_of_functions.py*)",
            "Read(*tools/get_topological_ordering_of_functions.py*)",
            "Bash(*construct_call_graph*)",
            "Bash(*tools/construct_call_graph.py*)",
            "Read(*tools/construct_call_graph.py*)",
            "Bash(*-callgraph.json)",
            "Read(*-callgraph.json)",
            "Read(*eval*)",
            "Read(**/*mutation_compile_failures.log)",
            "Bash(**/*mutation_compile_failures.log)"
        ]
    }
}

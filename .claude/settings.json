{
    "model": "claude-opus-4-8",
    "env": {
        "API_TIMEOUT_MS": "1200000",
        "BASH_DEFAULT_TIMEOUT_MS": "600000"
    },
    "permissions": {
        "allow": [
            "Bash(avocado-*)"
        ],
        "deny": [
            "Bash(avocado-count-sloc)",
            "Bash(*git*)",
            "Bash(*.git*)",
            "Read(*.git*)",
            "Bash(*eval*)",
            "Read(*eval*)",
            "Read(DEVELOPMENT.md)",
            "Read(**/*mutation_compile_failures.log)",
            "Bash(**/*mutation_compile_failures.log)"
        ]
    }
}

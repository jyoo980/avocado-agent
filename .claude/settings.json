{
    "model": "claude-fable-5-1",
    "env": {
        "CLAUDE_CODE_EFFORT_LEVEL": "high"
    },
    "permissions": {
        "allow": [
            "Bash(avocado-*)"
        ],
        "deny": [
            "Bash(git push * main)",
            "Bash(git push * main:*)",
            "Bash(git push * HEAD:main)",
            "Bash(git push * :main)",
            "Bash(git push --force*)",
            "Bash(git push -f *)",
            "Bash(git switch main)",
            "Bash(git checkout main)"
        ]
    }
}
